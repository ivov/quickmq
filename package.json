{
  "name": "quickmq",
  "version": "0.1.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.15",
    "pnpm": ">=9.7"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "sqs": "tsc -p tsconfig.build.json && node -r tsconfig-paths/register dist/sqs-test.js",
    "sns": "tsc -p tsconfig.build.json && node -r tsconfig-paths/register dist/sns-test.js",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "test": "jest",
    "test:cov": "jest --coverage && open coverage/lcov-report/index.html",
    "services:up": "docker-compose up -d",
    "services:down": "docker-compose down"
  },
  "dependencies": {
    "aws4": "^1.13.2",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/aws4": "^1.11.6",
    "@types/debug": "^4.1.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.11",
    "jest": "^29.7.0",
    "oxlint": "^0.15.2",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
